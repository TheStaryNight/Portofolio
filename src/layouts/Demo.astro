---
const {title, description}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} | Steven Changcherta</title><style is:global>
*{box-sizing:border-box}body{margin:0;background:#071b23;color:#e4f4ec;font:16px/1.6 system-ui,sans-serif}main{max-width:1080px;margin:auto;padding:35px 24px 70px}a{color:#b4e6c4}header{margin:32px 0}h1{font-size:clamp(32px,5vw,56px);line-height:1.1;margin:15px 0}h2{font-size:21px}p{color:#abc5c9}.eyebrow{letter-spacing:3px;font-size:12px;color:#b4e6c4}.grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.panel{background:#102b35;border:1px solid #36535b;border-radius:18px;padding:24px;min-width:0}button,.action{display:inline-block;padding:12px 18px;border-radius:8px;border:1px solid #b4e6c4;background:#b4e6c4;color:#071b23;font:inherit;font-weight:600;cursor:pointer;margin:5px 8px 5px 0}button:disabled{opacity:.5;cursor:wait}button.secondary{background:transparent;color:#b4e6c4}input{max-width:100%;padding:12px;background:#071b23;border:1px solid #65848b;color:white;border-radius:8px}img,video{max-width:100%;border-radius:12px}#preview{max-height:300px;object-fit:contain;width:100%;background:#071b23}#status{min-height:30px}#result{font-size:28px;color:#b4e6c4}progress{width:100%;accent-color:#b4e6c4}small{color:#abc5c9}.camera{position:relative;aspect-ratio:4/3;background:#030f16;border-radius:12px;overflow:hidden}.camera video,.camera canvas{position:absolute;width:100%;height:100%;object-fit:contain;transform:scaleX(-1)}.camera canvas{transform:none}select{display:block;background:#071b23;color:#e4f4ec;padding:10px;border:1px solid #65848b;border-radius:8px;margin-top:8px;max-width:100%}#playground{height:280px;background:#071b23;border:1px solid #56727a;position:relative;overflow:auto;border-radius:12px}#cursor{position:absolute;width:20px;height:20px;border:3px solid #b4e6c4;border-radius:50%;pointer-events:none;z-index:3;transform:translate(-50%,-50%)}#target{position:absolute;left:40%;top:40%;font-size:14px}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid white;outline-offset:4px}[hidden]{display:none!important}@media(max-width:700px){.grid{grid-template-columns:1fr}main{padding:20px 16px}.panel{padding:18px}}
</style></head><body><main><a href="/#work">← Back to selected work</a><header><span class="eyebrow">INTERACTIVE PROJECT DEMO</span><h1>{title}</h1><p>{description}</p></header><slot/></main></body></html>
