---
import '../styles/global.css';
import '../styles/descent.css';
import ProjectMotion from '../components/ProjectMotion.astro';
import WorkBackdrop from '../components/WorkBackdrop.astro';
import { projects } from '../data/projects';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Steven Changcherta — Computer Science student specializing in AI at BINUS University. Explore computer vision, machine learning, and interface design projects." />
    <meta name="theme-color" content="#06191f" />
    <meta property="og:title" content="Steven Changcherta — AI & Computer Vision" />
    <meta property="og:description" content="Exploring beneath the surface. Selected AI, computer vision, and design projects by Steven Changcherta." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Steven Changcherta — AI & Computer Vision</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
      <a class="logo signature-logo" href="#surface" aria-label="Steven Changcherta, home"><img src="/images/signature.png" width="640" height="300" alt="" /></a>
      <a class="header-label" href="#about">STEVEN CHANGCHERTA <span>AI & COMPUTER VISION</span></a>
      <nav aria-label="Main navigation">
        <a href="#work"><span>01</span> Work</a><a href="#about"><span>02</span> About</a><a href="#contact"><span>03</span> Contact <i>↗</i></a>
      </nav>
    </header>
    <main id="main">
      <section id="surface" class="hero" aria-labelledby="hero-title">
        <div class="ocean-light" aria-hidden="true"><span class="light-beam beam-one"></span><span class="light-beam beam-two"></span><span class="light-beam beam-three"></span></div>
        <div class="surface-glow" aria-hidden="true"></div><div class="pointer-light" aria-hidden="true"></div>
        <div class="plankton" aria-hidden="true">{Array.from({length: 24}, (_, i) => <span style={`--x:${(i * 37 + 9) % 100}%;--y:${(i * 23 + 5) % 100}%;--duration:${12 + i % 9}s;--delay:-${i * 1.7}s;--size:${i % 3 + 1}px`}></span>)}</div>
        <div class="grain" aria-hidden="true"></div><span class="hero-watermark" aria-hidden="true">DEEPER</span>
        <div class="hero-content">
          <p class="eyebrow"><span class="signal"></span> CURIOUS MIND. DEEPER POSSIBILITIES.</p>
          <h1 id="hero-title">Exploring<br/>beneath the<br/><em>surface.</em></h1>
          <div class="intro"><span class="intro-line" aria-hidden="true"></span><p>I’m <strong>Steven Changcherta.</strong><br/>A Computer Science student turning curiosity into<br class="desktop-break"/> computer vision, intelligent systems, and thoughtful design.</p></div>
          <a class="button" href="#work">Dive into my work <span>↓</span></a>
        </div>
        <div class="portrait-scene">
          <div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div>
          <span class="cross cross-one" aria-hidden="true">+</span><span class="cross cross-two" aria-hidden="true">+</span>
          <div class="portrait-frame"><img src="/images/portrait.png" alt="Steven Changcherta" width="316" height="307" fetchpriority="high" /><div class="portrait-shade"></div></div>
          <span class="portrait-coordinate">01° / A DIFFERENT PERSPECTIVE</span>
          <div class="portrait-caption"><span class="signal"></span><span>STEVEN CHANGCHERTA<small>Student. Builder. Always learning.</small></span></div>
        </div>
        <div class="hero-signature"><img src="/images/signature.png" width="640" height="300" alt="Steven Changcherta’s signature" /><span>A PERSONAL EXPLORATION</span></div><div class="hero-bottom"><button class="motion-toggle" type="button" aria-pressed="false">Pause motion <span aria-hidden="true">Ⅱ</span></button><span class="hero-bottom-center">AI / VISION / HUMAN EXPERIENCE</span><a href="#work">SCROLL TO EXPLORE <span>↓</span></a></div>
      </section>
      <section id="work" class="work section-wrap" aria-labelledby="work-title">
        <WorkBackdrop />
        <div class="section-heading"><p class="eyebrow"><span>01 /</span> SELECTED WORK</p><span class="section-note">A FEW THINGS I’VE BUILT · 2024—2026</span></div>
        <div class="section-intro work-intro"><h2 id="work-title">Curiosity,<br/>put into <em>practice.</em></h2><p>From recognizing ripeness to rethinking how we interact with a computer. Four projects, each a new way to learn by building.</p></div>
        <div class="work-depth-line" aria-hidden="true"><span>ENTERING THE EXPLORATION ZONE</span><span>01 — 04 / SELECTED EXPERIMENTS</span></div><div class="projects">
          {projects.map((project) => (
            <article class={`project project-${project.id}`}>
              <button type="button" class="project-visual" data-gallery={project.id} aria-label={`Enlarge ${project.name} images`}><ProjectMotion id={project.id} /><span class="visual-index">/ {project.number}</span><img src={`/images/${project.image}`} alt={project.alt} loading="lazy" width={project.id === 'gesture' ? 478 : 1100} height={project.id === 'gesture' ? 449 : 640} /><span class="visual-label">{project.name}</span><span class="visual-open" aria-hidden="true">VIEW GALLERY ↗</span></button>
              <div class="project-copy"><p class="eyebrow">{project.category}</p><h3>{project.title.split('\n').map(line => <span>{line}</span>)}</h3><p>{project.description}</p><div class="project-highlight"><strong>{project.metric}</strong><span>{project.metricLabel}</span></div><ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul><a class="text-link" href={project.link} target="_blank" rel="noopener noreferrer">{project.linkLabel}<span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div>
              <button type="button" class="project-details project-open" data-project={project.id} aria-haspopup="dialog"><span>Inside the project</span><span aria-hidden="true">↗</span></button>
              <dialog class="project-modal" id={`project-${project.id}`} aria-labelledby={`modal-title-${project.id}`}><div class="modal-toolbar"><span>PROJECT // {project.number}</span><button class="project-close" type="button" aria-label="Close project details">×</button></div><div class="modal-body"><p class="eyebrow">{project.category}</p><h2 id={`modal-title-${project.id}`}>{project.name}</h2><div class="modal-overview"><div><p class="modal-role"><span>MY ROLE</span>{project.role}</p><p class="modal-description">{project.description}</p></div><aside class="modal-result"><span>PROJECT HIGHLIGHT</span><strong>{project.metric}</strong><h3>{project.metricLabel}</h3><p>{project.metricNote}</p></aside></div><ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul><a class="button" href={project.link} target="_blank" rel="noopener noreferrer">{project.linkLabel} ↗<span class="sr-only"> (opens in a new tab)</span></a><div class="details-content"><p class="project-meta">{project.role} <span>{project.date}</span></p><div class="detail-grid"><div><h4>My contribution</h4><p>{project.contribution}</p></div><div><h4>The challenge</h4><p>{project.challenge}</p></div><div><h4>What came out of it</h4><p>{project.outcome}</p></div></div><h3 class="gallery-heading">Project visuals <span>// EXPLORE THE DETAILS</span></h3><div class={`gallery ${project.id === 'gesture' ? 'gesture-gallery' : ''}`}>{project.gallery.map((img,i) => <img src={`/images/${img}`} alt={project.id === 'gesture' ? `Hand landmark demonstration ${i+1}` : `${project.name} project screenshot ${i+1}`} loading="lazy" />)}</div></div></div></dialog>
            </article>
          ))}
        </div>
      </section>
      <section id="about" class="about section-wrap" aria-labelledby="about-title">
        <div class="section-heading"><p class="eyebrow"><span>02 /</span> A LITTLE ABOUT ME</p><span class="section-note">MORE THAN A COLLECTION OF PROJECTS</span></div>
        <div class="about-grid"><div><h2 id="about-title">A little deeper.<br/><em>A little further.</em></h2><p class="about-lead">I like understanding how things work.<br/>Then figuring out what they could become.</p><p>I’m a third-year Computer Science student specializing in AI at BINUS University. My interests sit at the intersection of computer vision, factory automation, and quality control.</p><p>My projects are where I explore those interests: training models, building interfaces, and working with teammates to turn an idea into something usable. I’m looking to grow as an AI engineer.</p><a class="text-link" href="/Steven-Changcherta-CV.pdf" download>Download my CV <span>↓</span></a><div class="about-signature"><img src="/images/signature.png" width="640" height="300" alt="Steven Changcherta’s signature" /><span>Always curious. Always learning.</span></div></div>
          <div class="experience"><div class="experience-row"><span class="eyebrow">EDUCATION / 01</span><h3>BINUS University</h3><p>Computer Science · Artificial Intelligence</p><div class="experience-footer"><span>Expected graduation 2028</span><span>GPA 3.4</span></div></div><div class="experience-row"><span class="eyebrow">LEADERSHIP / 02</span><h3>Making things happen, together.</h3><p>Scrabble Division Coordinator<br/>BEAMS Club Competition · 2024</p><p class="small">Coordinated the team, assigned responsibilities, and oversaw design decisions for the competition division.</p></div><div class="toolbox"><span class="eyebrow">MY TOOLBOX</span><p>Python · PyTorch · MediaPipe · scikit-learn<br/>React · HTML & CSS · Node.js · Figma<br/>C · Java</p></div></div></div>
      </section>
      <section id="contact" class="contact section-wrap" aria-labelledby="contact-title"><div class="contact-glow" aria-hidden="true"></div><div class="deep-stars" aria-hidden="true">{Array.from({length:18},(_,i) => <i style={`--x:${(i*37+8)%100}%;--y:${(i*19+5)%100}%;--delay:-${i*.7}s`}></i>)}</div><p class="eyebrow"><span>03 /</span> NEXT CHAPTER</p><p class="contact-pre">Good things start with a conversation.</p><h2 id="contact-title">Let’s explore<br/><em>what’s next.</em></h2><p>Have an AI engineering internship or a project in mind?<br/>I’d love to hear about it.</p><a class="contact-email" href="mailto:steven.changcherta@binus.ac.id">steven.changcherta@binus.ac.id <span>↗</span></a><div class="contact-socials"><a href="https://github.com/TheStaryNight" target="_blank" rel="noopener noreferrer">GitHub ↗<span class="sr-only"> (opens in a new tab)</span></a><a href="https://www.linkedin.com/in/steven-changcherta-a62399323" target="_blank" rel="noopener noreferrer">LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span></a><a href="/Steven-Changcherta-CV.pdf" download>Résumé ↓</a></div></section>
    </main>
    <nav class="depth-nav" aria-label="Ocean depth navigation"><span class="depth-nav-label">THE DESCENT</span><div class="depth-track"><span class="depth-fill"></span></div><a href="#surface" data-depth="surface" aria-label="Surface — Introduction" title="Surface — Introduction" aria-current="location"><span class="depth-dot"></span><span>Surface<small>INTRODUCTION</small></span></a><a href="#work" data-depth="work" aria-label="Exploration — Selected work" title="Exploration — Selected work"><span class="depth-dot"></span><span>Exploration<small>SELECTED WORK</small></span></a><a href="#about" data-depth="about" aria-label="Deep dive — About me" title="Deep dive — About me"><span class="depth-dot"></span><span>Deep dive<small>ABOUT ME</small></span></a><a href="#contact" data-depth="contact" aria-label="The horizon — Contact" title="The horizon — Contact"><span class="depth-dot"></span><span>The horizon<small>LET’S CONNECT</small></span></a><span class="depth-readout" aria-hidden="true">000% / DESCENT</span></nav>
    <div class="reading-progress" aria-hidden="true"></div>
    <dialog class="image-viewer" aria-label="Project image gallery"><div class="viewer-top"><span class="viewer-title"></span><button type="button" class="viewer-close" aria-label="Close image gallery">Close ×</button></div><img class="viewer-image" alt="" /><div class="viewer-bottom"><button type="button" class="viewer-prev" aria-label="Previous image">← Previous</button><span class="viewer-count" aria-live="polite"></span><button type="button" class="viewer-next" aria-label="Next image">Next →</button></div></dialog>
    <script type="application/json" id="gallery-data" set:html={JSON.stringify(projects.map(p => ({id:p.id, name:p.name, images:[...new Set([p.image,...p.gallery])]}))).replace(/</g, '\u003c')} />
    <footer><a class="logo signature-logo" href="#surface" aria-label="Back to top"><img src="/images/signature.png" width="640" height="300" alt="" /></a><p>© {new Date().getFullYear()} Steven Changcherta</p><span>BUILT WITH CURIOSITY & ASTRO</span><a href="#">Back to the surface ↑</a></footer>
    <script>
      import '../scripts/interactions';
      const links = document.querySelectorAll<HTMLAnchorElement>('nav a');
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach(link => {
              if (link.hash === '#' + entry.target.id) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          }
        }
      }, { rootMargin: '-15% 0px -55% 0px', threshold: 0 });
      document.querySelectorAll('main > section').forEach(section => observer.observe(section));
    </script>
  </body>
</html>
